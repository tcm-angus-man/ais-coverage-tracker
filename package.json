{
  "name": "ais-coverage-tracker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshot:local": "node --env-file=.env.local node_modules/.bin/tsx scripts/snapshot-local.ts",
    "sheets:dump": "tsx scripts/sheets-dump.ts",
    "tier:coverage": "node --env-file=.env.local node_modules/.bin/tsx scripts/tier-print-coverage.ts",
    "sheet:fill-shared-mmsi": "node --env-file=.env.local node_modules/.bin/tsx scripts/fill-shared-mmsi.ts",
    "sheet:prune-shared-mmsi": "node --env-file=.env.local node_modules/.bin/tsx scripts/prune-shared-mmsi.ts"
  },
  "dependencies": {
    "googleapis": "^144.0.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.10",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/blob": "^2.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
