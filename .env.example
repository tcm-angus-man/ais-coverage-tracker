# Copy to .env.local and fill in. NEVER commit .env*.local files.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                # `openssl rand -base64 32`

# Google OAuth (NextAuth provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google service account for Sheets writes (single-line JSON or path)
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_WORKBOOK_ID=

# Postgres read replica (used only by /api/cron/snapshot)
DATABASE_URL=

# Vercel Blob (snapshot store)
BLOB_READ_WRITE_TOKEN=

# Cron secret — Vercel Cron adds this header; we verify on /api/cron/*
CRON_SECRET=

# Snapshot config
SNAPSHOT_DAYS_BACK=730
